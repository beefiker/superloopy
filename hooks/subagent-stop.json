{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^(?:forge|sentinel|probe|arbiter)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/src/cli.js\" hook subagent-stop",
            "timeout": 5,
            "statusMessage": "(Superloopy) Verifying Evidence Receipt"
          }
        ]
      },
      {
        "matcher": "^superloopy:(?:forge|sentinel|probe|arbiter)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/src/cli.js\" hook subagent-stop --host antigravity",
            "timeout": 5,
            "statusMessage": "(Superloopy) Verifying Evidence Receipt"
          }
        ]
      },
      {
        "matcher": "^pathfinder$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/src/cli.js\" hook subagent-stop",
            "timeout": 5,
            "statusMessage": "(Superloopy) Navigator (read-only) — no receipt required"
          }
        ]
      },
      {
        "matcher": "^superloopy:pathfinder$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/src/cli.js\" hook subagent-stop --host antigravity",
            "timeout": 5,
            "statusMessage": "(Superloopy) Navigator (read-only) — no receipt required"
          }
        ]
      }
    ]
  }
}
